# --- Database (SQLite, file-based) ---
DATABASE_URL=file:/home/z/my-project/db/custom.db

# --- Optional: portable AI mode ---------------------------------------
# If set, every AI call goes to this OpenAI-compatible endpoint.
# If unset, the app falls back to the bundled z-ai-web-dev-sdk (sandbox).
#
# Examples:
#   GLM:      AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4      AI_MODEL=glm-4.6
#   OpenAI:   AI_BASE_URL=https://api.openai.com/v1                 AI_MODEL=gpt-4o-mini
#   DeepSeek: AI_BASE_URL=https://api.deepseek.com/v1               AI_MODEL=deepseek-chat
#   Ollama:   AI_BASE_URL=http://localhost:11434/v1                 AI_MODEL=llama3.1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
